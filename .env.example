NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:5173
# Absolute path on a persistent disk in production. Includes listings, sessions and image blobs.
DATABASE_PATH=./data/prism.sqlite
# Required in production; generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# Set to 1 ONLY behind one trusted reverse proxy.
TRUST_PROXY=0
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
PRISM_NOTIFICATION_EMAIL=info@prismedu.in
# International digits only, e.g. country code followed by number. No sample business number.
PRISM_WHATSAPP_NUMBER=919518963309


# Used by the explicit Admin setup/reset command.
ADMIN_USERNAME=admin@example.com
# Run npm run admin:setup to enter the initial/reset password securely.
# Never use a VITE_ variable for admin credentials or SESSION_SECRET.
